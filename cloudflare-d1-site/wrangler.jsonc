{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qzefirst-cloud",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qzefirst_todo",
      "database_id": "eb8f7413-0c44-4d5a-892a-f00c7a55ef4c"
    }
  ]
}
